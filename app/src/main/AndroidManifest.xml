<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 공휴일 조회(한국천문연구원 특일 정보 API) 용. 그 외 서버/계정 없음(원칙 B). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        장치를 USB 대용량 저장장치(MSC)로 인식시키고 SAF로 접근한다(8.3절).
        USB_PERMISSION은 SAF(ACTION_OPEN_DOCUMENT_TREE) 경로에서는 필요하지 않지만,
        장치 연결 여부를 감지하는 데는 UsbManager 접근이 필요할 수 있다.
    -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".HagoondoriApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Hagoondori"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hagoondori"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                장치가 USB MSC로 인식되면(F17, 8.3절) 시스템이 이 액티비티를 자동으로
                띄워줄 수 있게 하는 필터. 실제 vendor/product ID는 장치 하드웨어가
                확정된 뒤 device_filter.xml을 채운다(RealExportAdapter 구현 단계).
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!--
            홈 화면 요약 위젯. 자정 알람과 앱 내부 갱신은 명시적 인텐트로 받으므로 필터에 넣지 않는다.
            새 권한은 쓰지 않는다.
        -->
        <receiver
            android:name=".widget.SummaryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_summary_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/summary_widget_info" />
        </receiver>

        <!-- 홈 화면 달력 위젯. 시스템 액션은 요약 위젯과 같고, 월 이동과 자정·갱신은 명시적 인텐트로 받는다. -->
        <receiver
            android:name=".widget.CalendarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- 자정 알람을 받는 앱 내부 수신자. 외부 앱은 보낼 수 없다. -->
        <receiver
            android:name=".widget.WidgetMidnightReceiver"
            android:exported="false" />
    </application>
</manifest>
