<?xml version="1.0" encoding="utf-8"?>
<!--
    요약 위젯 가로로 늘린 크기(4×1, 폭 250dp 이상). 왼쪽 제목, 오른쪽 위 오늘 근무 칩,
    오른쪽 아래 다음 진급, 아래 전체 폭 게이지. 근무가 없으면 칩 줄 전체, 진급이 없으면 진급 줄을 숨긴다.
    글자는 모두 렌더러가 그린 비트맵이다. 진급 줄은 칸 폭에 맞춰 줄어들도록 폭을 칸에 맞춘다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitStart" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/duty_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/chip_duty"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/widget_chip_duty"
                    android:scaleType="center" />

                <ImageView
                    android:id="@+id/chip_off_duty"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/widget_chip_off_duty"
                    android:scaleType="center"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/chip_mess"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/widget_chip_mess"
                    android:scaleType="center" />

                <ImageView
                    android:id="@+id/label_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:adjustViewBounds="true" />
            </LinearLayout>

            <ImageView
                android:id="@+id/promotion"
                android:layout_width="match_parent"
                android:layout_height="14.5dp"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/gauge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:indeterminateOnly="false"
            android:max="100"
            android:maxHeight="14dp"
            android:minHeight="14dp"
            android:progressDrawable="@drawable/widget_gauge" />

        <ImageView
            android:id="@+id/percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:adjustViewBounds="true" />
    </LinearLayout>
</LinearLayout>
