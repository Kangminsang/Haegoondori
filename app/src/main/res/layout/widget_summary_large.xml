<?xml version="1.0" encoding="utf-8"?>
<!--
    요약 위젯 큰 크기(4×2). 제목과 오늘 근무 칩, 게이지와 진행률, 그리고 항목 네 줄
    (다음 진급 / 다음 출타 / 다음 외출 / 휴가 잔여). 값이 없는 줄은 숨긴다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/galmuri14"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/duty_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/chip_duty"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/widget_chip_duty"
                android:fontFamily="@font/galmuri11_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textColor="@color/widget_paper"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chip_off_duty"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/widget_chip_off_duty"
                android:fontFamily="@font/galmuri11_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textColor="@color/widget_ink"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chip_mess"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/widget_chip_mess"
                android:fontFamily="@font/galmuri11_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textColor="@color/widget_paper"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/label_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/galmuri11"
                android:includeFontPadding="false"
                android:text="@string/widget_today"
                android:textColor="@color/widget_ink"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/gauge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:indeterminateOnly="false"
            android:max="100"
            android:maxHeight="14dp"
            android:minHeight="14dp"
            android:progressDrawable="@drawable/widget_gauge" />

        <TextView
            android:id="@+id/percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/galmuri11"
            android:includeFontPadding="false"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_promotion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/galmuri11_bold"
            android:includeFontPadding="false"
            android:text="@string/widget_row_promotion"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/value_promotion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/galmuri11"
            android:gravity="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_outing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/galmuri11_bold"
            android:includeFontPadding="false"
            android:text="@string/widget_row_outing"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/value_outing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/galmuri11"
            android:gravity="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_pass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/galmuri11_bold"
            android:includeFontPadding="false"
            android:text="@string/widget_row_pass"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/value_pass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/galmuri11"
            android:gravity="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_leave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/galmuri11_bold"
            android:includeFontPadding="false"
            android:text="@string/widget_row_leave"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/value_leave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/galmuri11"
            android:gravity="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
