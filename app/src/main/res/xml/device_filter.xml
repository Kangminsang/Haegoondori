<?xml version="1.0" encoding="utf-8"?>
<!--
    USB 장치 연결 시 시스템이 이 앱을 자동 실행 후보로 띄우기 위한 필터
    (AndroidManifest.xml의 USB_DEVICE_ATTACHED 인텐트 필터가 참조한다).

    장치는 RP2040(Raspberry Pi) MicroPython 커스텀 빌드이므로 vendor-id는 Raspberry Pi의
    0x2E8A(= 11914)다. product-id는 빌드 설정에 따라 달라질 수 있어 지정하지 않는다 -
    실기기를 연결해 UsbManager.deviceList로 확인한 뒤 필요하면 좁힌다.
    이 필터는 "USB 연결 시 앱이 후보로 뜨는" 편의 기능일 뿐이며, 동기화 자체(SAF로
    calendar.txt 쓰기)에는 영향이 없다.
-->
<resources>
    <usb-device vendor-id="11914" />
</resources>
